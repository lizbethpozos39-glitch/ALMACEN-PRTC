### Siguiente paso

Antes de programar las pantallas, podemos hacer **el SQL completo para crear `comercial_db`**, incluyendo todas las tablas, relaciones, índices y datos iniciales.

Después de ejecutarlo en **phpMyAdmin**, empezamos con `conexion.php` y la pantalla de **Clientes**.
Sí. Vamos a crear **`comercial_db` completamente independiente** del inventario y dejando preparada la estructura para que después podamos programar clientes, cotizaciones, PDF, seguimiento y auditoría.

Ejecuta este SQL completo en **phpMyAdmin → SQL**.

```sql
-- ==========================================================
-- BASE DE DATOS: SISTEMA COMERCIAL
-- ==========================================================

CREATE DATABASE IF NOT EXISTS comercial_db
CHARACTER SET utf8mb4
COLLATE utf8mb4_unicode_ci;

USE comercial_db;


-- ==========================================================
-- TABLA: CLIENTES
-- ==========================================================

CREATE TABLE IF NOT EXISTS clientes (
    id INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,

    tipo_cliente ENUM('PERSONA','EMPRESA')
        NOT NULL DEFAULT 'EMPRESA',

    nombre VARCHAR(150) NOT NULL,
    razon_social VARCHAR(200) NULL,
    rfc VARCHAR(20) NULL,

    contacto VARCHAR(150) NULL,
    telefono VARCHAR(30) NULL,
    telefono2 VARCHAR(30) NULL,
    correo VARCHAR(150) NULL,

    calle VARCHAR(150) NULL,
    numero VARCHAR(30) NULL,
    colonia VARCHAR(100) NULL,
    ciudad VARCHAR(100) NULL,
    estado VARCHAR(100) NULL,
    codigo_postal VARCHAR(10) NULL,

    notas TEXT NULL,

    estatus ENUM('ACTIVO','INACTIVO')
        NOT NULL DEFAULT 'ACTIVO',

    fecha_registro DATETIME
        NOT NULL DEFAULT CURRENT_TIMESTAMP,

    fecha_actualizacion DATETIME
        NOT NULL DEFAULT CURRENT_TIMESTAMP
        ON UPDATE CURRENT_TIMESTAMP,

    INDEX idx_clientes_nombre (nombre),
    INDEX idx_clientes_rfc (rfc),
    INDEX idx_clientes_estatus (estatus)
) ENGINE=InnoDB;


-- ==========================================================
-- TABLA: PRODUCTOS / SERVICIOS
-- ==========================================================

CREATE TABLE IF NOT EXISTS productos (
    id INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,

    codigo VARCHAR(50) NOT NULL,
    descripcion VARCHAR(255) NOT NULL,

    tipo ENUM('PRODUCTO','SERVICIO')
        NOT NULL DEFAULT 'PRODUCTO',

    unidad VARCHAR(30)
        NOT NULL DEFAULT 'PZA',

    categoria VARCHAR(100) NULL,

    precio DECIMAL(12,2)
        NOT NULL DEFAULT 0.00,

    iva DECIMAL(5,2)
        NOT NULL DEFAULT 16.00,

    costo DECIMAL(12,2)
        NOT NULL DEFAULT 0.00,

    notas TEXT NULL,

    activo TINYINT(1)
        NOT NULL DEFAULT 1,

    fecha_registro DATETIME
        NOT NULL DEFAULT CURRENT_TIMESTAMP,

    fecha_actualizacion DATETIME
        NOT NULL DEFAULT CURRENT_TIMESTAMP
        ON UPDATE CURRENT_TIMESTAMP,

    UNIQUE KEY uk_productos_codigo (codigo),
    INDEX idx_productos_descripcion (descripcion),
    INDEX idx_productos_activo (activo)
) ENGINE=InnoDB;


-- ==========================================================
-- TABLA: COTIZACIONES
-- ==========================================================

CREATE TABLE IF NOT EXISTS cotizaciones (
    id INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,

    folio VARCHAR(30) NOT NULL,

    cliente_id INT UNSIGNED NOT NULL,

    responsable VARCHAR(150) NULL,

    fecha DATE NOT NULL,

    vigencia DATE NULL,

    subtotal DECIMAL(12,2)
        NOT NULL DEFAULT 0.00,

    descuento DECIMAL(12,2)
        NOT NULL DEFAULT 0.00,

    iva DECIMAL(12,2)
        NOT NULL DEFAULT 0.00,

    total DECIMAL(12,2)
        NOT NULL DEFAULT 0.00,

    estatus ENUM(
        'BORRADOR',
        'ENVIADA',
        'EN_SEGUIMIENTO',
        'ACEPTADA',
        'RECHAZADA',
        'VENCIDA'
    )
    NOT NULL DEFAULT 'BORRADOR',

    observaciones TEXT NULL,

    condiciones TEXT NULL,

    fecha_seguimiento DATE NULL,

    fecha_registro DATETIME
        NOT NULL DEFAULT CURRENT_TIMESTAMP,

    fecha_actualizacion DATETIME
        NOT NULL DEFAULT CURRENT_TIMESTAMP
        ON UPDATE CURRENT_TIMESTAMP,

    CONSTRAINT fk_cotizaciones_cliente
        FOREIGN KEY (cliente_id)
        REFERENCES clientes(id)
        ON UPDATE CASCADE
        ON DELETE RESTRICT,

    UNIQUE KEY uk_cotizaciones_folio (folio),

    INDEX idx_cotizaciones_cliente (cliente_id),
    INDEX idx_cotizaciones_fecha (fecha),
    INDEX idx_cotizaciones_estatus (estatus),
    INDEX idx_cotizaciones_seguimiento (fecha_seguimiento)

) ENGINE=InnoDB;


-- ==========================================================
-- TABLA: DETALLE DE COTIZACIONES
-- ==========================================================

CREATE TABLE IF NOT EXISTS cotizacion_detalles (
    id INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,

    cotizacion_id INT UNSIGNED NOT NULL,

    producto_id INT UNSIGNED NULL,

    descripcion VARCHAR(255) NOT NULL,

    cantidad DECIMAL(12,2)
        NOT NULL DEFAULT 1.00,

    unidad VARCHAR(30)
        NOT NULL DEFAULT 'PZA',

    precio_unitario DECIMAL(12,2)
        NOT NULL DEFAULT 0.00,

    descuento DECIMAL(12,2)
        NOT NULL DEFAULT 0.00,

    iva_porcentaje DECIMAL(5,2)
        NOT NULL DEFAULT 16.00,

    iva_importe DECIMAL(12,2)
        NOT NULL DEFAULT 0.00,

    importe DECIMAL(12,2)
        NOT NULL DEFAULT 0.00,

    orden INT
        NOT NULL DEFAULT 1,

    CONSTRAINT fk_detalle_cotizacion
        FOREIGN KEY (cotizacion_id)
        REFERENCES cotizaciones(id)
        ON UPDATE CASCADE
        ON DELETE CASCADE,

    CONSTRAINT fk_detalle_producto
        FOREIGN KEY (producto_id)
        REFERENCES productos(id)
        ON UPDATE CASCADE
        ON DELETE SET NULL,

    INDEX idx_detalle_cotizacion (cotizacion_id),
    INDEX idx_detalle_producto (producto_id)

) ENGINE=InnoDB;


-- ==========================================================
-- TABLA: SEGUIMIENTOS COMERCIALES
-- ==========================================================

CREATE TABLE IF NOT EXISTS seguimientos (
    id INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,

    cliente_id INT UNSIGNED NOT NULL,

    cotizacion_id INT UNSIGNED NULL,

    fecha DATETIME
        NOT NULL DEFAULT CURRENT_TIMESTAMP,

    tipo_contacto ENUM(
        'LLAMADA',
        'WHATSAPP',
        'CORREO',
        'VISITA',
        'REUNION',
        'OTRO'
    )
    NOT NULL DEFAULT 'LLAMADA',

    resultado ENUM(
        'SIN_RESPUESTA',
        'INTERESADO',
        'EN_REVISION',
        'NEGOCIACION',
        'ACEPTADO',
        'RECHAZADO',
        'PENDIENTE',
        'OTRO'
    )
    NOT NULL DEFAULT 'PENDIENTE',

    comentarios TEXT NULL,

    proximo_seguimiento DATE NULL,

    responsable VARCHAR(150) NULL,

    fecha_registro DATETIME
        NOT NULL DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT fk_seguimientos_cliente
        FOREIGN KEY (cliente_id)
        REFERENCES clientes(id)
        ON UPDATE CASCADE
        ON DELETE RESTRICT,

    CONSTRAINT fk_seguimientos_cotizacion
        FOREIGN KEY (cotizacion_id)
        REFERENCES cotizaciones(id)
        ON UPDATE CASCADE
        ON DELETE SET NULL,

    INDEX idx_seguimientos_cliente (cliente_id),
    INDEX idx_seguimientos_cotizacion (cotizacion_id),
    INDEX idx_seguimientos_fecha (fecha),
    INDEX idx_seguimientos_proximo (proximo_seguimiento)

) ENGINE=InnoDB;


-- ==========================================================
-- TABLA: AUDITORÍA
-- ==========================================================

CREATE TABLE IF NOT EXISTS auditoria (
    id BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY,

    usuario VARCHAR(150) NULL,

    accion VARCHAR(100) NOT NULL,

    modulo VARCHAR(100) NULL,

    registro_id INT UNSIGNED NULL,

    descripcion TEXT NULL,

    ip VARCHAR(45) NULL,

    fecha DATETIME
        NOT NULL DEFAULT CURRENT_TIMESTAMP,

    INDEX idx_auditoria_usuario (usuario),
    INDEX idx_auditoria_accion (accion),
    INDEX idx_auditoria_modulo (modulo),
    INDEX idx_auditoria_fecha (fecha)

) ENGINE=InnoDB;


