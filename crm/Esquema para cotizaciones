                $tipo,
                $unidad,
                $categoria,
                $precio_num,
                $iva_num,
                $costo_num,
                $notas,
                $activo
            );

            if ($stmt->execute()) {

                $nuevo_id = $stmt->insert_id;

                $stmt->close();

                header(
                    "Location: editar_producto.php?id="
