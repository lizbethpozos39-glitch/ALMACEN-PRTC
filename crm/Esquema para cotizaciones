```php
<?php

require_once __DIR__ . '/conexion.php';
require_once __DIR__ . '/seguridad.php';

$mensaje = "";

if (
    isset($_SESSION['comercial_usuario_id']) &&
    !empty($_SESSION['comercial_usuario_id'])
) {
    header("Location: index.php");
    exit;
}


/*
|--------------------------------------------------------------------------
| PROCESAR LOGIN
|--------------------------------------------------------------------------
*/

if ($_SERVER['REQUEST_METHOD'] === 'POST') {

    $usuario = trim($_POST['usuario'] ?? '');
    $password = $_POST['password'] ?? '';

    if ($usuario === '' || $password === '') {

        $mensaje = "Ingresa usuario y contraseña.";

    } else {

        /*
        |--------------------------------------------------------------------------
        | IMPORTANTE
        |
        | Se consulta la base empresarial.
        | Si empleados/usuarios están en inventario_db,
        | se utiliza el nombre de la base directamente.
        |--------------------------------------------------------------------------
        */

        $sql = "
            SELECT
                u.id,
                u.empleado_id,
                u.usuario,
                u.password_hash,
                u.rol,
                u.activo,

                e.nombre,
                e.apellido_paterno,
                e.apellido_materno,
                e.puesto,
                e.area

            FROM inventario_db.usuarios u

            INNER JOIN inventario_db.empleados e
                ON e.id = u.empleado_id

            WHERE u.usuario = ?
              AND u.activo = 1
              AND e.activo = 1

            LIMIT 1
        ";

        $stmt = $conexion->prepare($sql);

        if (!$stmt) {

            $mensaje = "No fue posible consultar el usuario.";

        } else {

            $stmt->bind_param(
                "s",
                $usuario
            );

            $stmt->execute();

            $resultado = $stmt->get_result();

            if ($resultado->num_rows === 1) {

                $datos = $resultado->fetch_assoc();

                /*
                |--------------------------------------------------------------------------
                | VALIDAR CONTRASEÑA
                |--------------------------------------------------------------------------
                */

                if (
                    password_verify(
                        $password,
                        $datos['password_hash']
                    )
                ) {

                    session_regenerate_id(true);

                    $_SESSION['comercial_usuario_id'] =
                        $datos['id'];

                    $_SESSION['comercial_empleado_id'] =
                        $datos['empleado_id'];

                    $_SESSION['comercial_usuario'] =
                        $datos['usuario'];

                    $_SESSION['comercial_rol'] =
                        strtoupper($datos['rol']);

                    $_SESSION['comercial_nombre'] =
                        trim(
                            $datos['nombre'] . ' ' .
                            $datos['apellido_paterno'] . ' ' .
                            $datos['apellido_materno']
                        );

                    $_SESSION['comercial_puesto'] =
                        $datos['puesto'];

                    $_SESSION['comercial_area'] =
                        $datos['area'];

                    /*
                    |--------------------------------------------------------------------------
                    | REGISTRAR ACCESO EN AUDITORÍA
                    |--------------------------------------------------------------------------
                    */

                    $usuario_auditoria =
                        $_SESSION['comercial_usuario'];

                    $accion = "LOGIN";

                    $modulo = "Sistema";

                    $descripcion =
                        "Inicio de sesión en Sistema Comercial";

                    $ip =
                        $_SERVER['REMOTE_ADDR'] ?? '';

                    $stmt_auditoria = $conexion->prepare("
                        INSERT INTO auditoria
                        (
                            usuario,
                            accion,
                            modulo,
                            registro_id,
                            descripcion,
                            ip
                        )
                        VALUES (?, ?, ?, NULL, ?, ?)
                    ");

                    if ($stmt_auditoria) {

                        $stmt_auditoria->bind_param(
                            "sssss",
                            $usuario_auditoria,
                            $accion,
                            $modulo,
                            $descripcion,
                            $ip
                        );

                        $stmt_auditoria->execute();

                        $stmt_auditoria->close();
                    }

                    $stmt->close();

                    header("Location: index.php");
                    exit;

                } else {

                    $mensaje =
                        "Usuario o contraseña incorrectos.";
                }

            } else {

                $mensaje =
                    "Usuario o contraseña incorrectos.";
            }

            $stmt->close();
        }
    }
}

