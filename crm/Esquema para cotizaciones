-- ==========================================================
-- VISTA: RESUMEN DE COTIZACIONES
-- ==========================================================

CREATE OR REPLACE VIEW vista_cotizaciones AS
SELECT

    c.id,
    c.folio,
    c.fecha,
    c.vigencia,

    c.cliente_id,
    cl.nombre AS cliente,
    cl.razon_social,
    cl.rfc,

    c.responsable,

    c.subtotal,
    c.descuento,
    c.iva,
    c.total,

    c.estatus,
    c.fecha_seguimiento,

    c.fecha_registro,
    c.fecha_actualizacion

FROM cotizaciones c

INNER JOIN clientes cl
    ON cl.id = c.cliente_id;


-- ==========================================================
-- VISTA: SEGUIMIENTOS
-- ==========================================================

CREATE OR REPLACE VIEW vista_seguimientos AS
SELECT

    s.id,

    s.cliente_id,
    cl.nombre AS cliente,

    s.cotizacion_id,
    c.folio AS folio_cotizacion,

    s.fecha,
    s.tipo_contacto,
    s.resultado,

    s.comentarios,
    s.proximo_seguimiento,
    s.responsable,

    s.fecha_registro

FROM seguimientos s

INNER JOIN clientes cl
    ON cl.id = s.cliente_id

LEFT JOIN cotizaciones c
    ON c.id = s.cotizacion_id;


-- ==========================================================
-- FIN
-- ==========================================================

