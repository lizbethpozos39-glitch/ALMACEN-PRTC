                codigo,
                descripcion,
                tipo,
                unidad,
                categoria,
                precio,
                iva,
                costo,
                notas,
                activo
            )
            VALUES (
                ?, ?, ?, ?, ?, ?, ?, ?, ?, ?
            )
        ";

        $stmt = $conexion->prepare($sql);

        if (!$stmt) {

            $mensaje = "Error al preparar el registro: "
