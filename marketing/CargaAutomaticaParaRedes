# 3. Crear `meta_api.php`

Ahora crea:

```text
C:\xampp\htdocs\inventario\marketing\meta_api.php
```

Con esto:

```php
<?php

require_once __DIR__ . '/meta_config.php';


/*
|--------------------------------------------------------------------------
| PETICIÓN GRAPH API
|--------------------------------------------------------------------------
*/

function meta_request(
    $endpoint,
    $method = 'POST',
    $data = []
) {

    $url =
        META_GRAPH_URL .
        '/' .
        ltrim($endpoint, '/');


    $ch = curl_init();


    if ($method === 'GET') {

        if (!empty($data)) {

            $url .= '?' . http_build_query($data);

        }

    }


    curl_setopt_array(
        $ch,
        [

            CURLOPT_URL => $url,

            CURLOPT_RETURNTRANSFER => true,

            CURLOPT_TIMEOUT => 60,

            CURLOPT_CONNECTTIMEOUT => 15,

            CURLOPT_FOLLOWLOCATION => true,

            CURLOPT_SSL_VERIFYPEER => true,

            CURLOPT_SSL_VERIFYHOST => 2,

            CURLOPT_HTTPHEADER => [
                'Accept: application/json'
            ]

        ]
    );


    if ($method === 'POST') {

        curl_setopt(
            $ch,
            CURLOPT_POST,
            true
        );


        curl_setopt(
            $ch,
            CURLOPT_POSTFIELDS,
            http_build_query($data)
        );

    }


    $respuesta = curl_exec($ch);


    $curl_error = curl_error($ch);


    $http_code =
        curl_getinfo(
            $ch,
            CURLINFO_HTTP_CODE
        );


    curl_close($ch);


    if ($respuesta === false) {

        return [

            'ok' => false,

            'http_code' => $http_code,

            'error' => $curl_error,

            'data' => null

        ];

    }


    $json =
        json_decode(
            $respuesta,
            true
        );


    if (
        !is_array($json)
    ) {

        return [

            'ok' => false,

            'http_code' => $http_code,

            'error' =>
                'Meta devolvió una respuesta no válida.',

            'raw' => $respuesta,

            'data' => null

        ];

    }


    if (
        isset($json['error'])
    ) {

        return [

            'ok' => false,

            'http_code' => $http_code,

            'error' =>
                $json['error']['message']
                ?? 'Error desconocido de Meta.',

            'data' => $json

        ];

    }


    return [

        'ok' =>
            $http_code >= 200 &&
            $http_code < 300,

        'http_code' => $http_code,

        'error' => null,

        'data' => $json

    ];
}


/*
|--------------------------------------------------------------------------
| PUBLICAR EN FACEBOOK
|--------------------------------------------------------------------------
*/

function meta_publicar_facebook(
    $imagen_url,
    $texto
) {

    if (
        !META_PUBLICAR_FACEBOOK
    ) {

        return [

            'ok' => false,

            'estado' => 'NO_CONFIGURADO',

            'error' =>
                'La publicación en Facebook está desactivada.'

        ];

    }


    if (
        !meta_configuracion_valida()
    ) {

        return [

            'ok' => false,

            'estado' => 'NO_CONFIGURADO',

            'error' =>
                'La configuración de Meta está incompleta.'

        ];

    }


    $respuesta =
        meta_request(
            META_PAGE_ID . '/photos',
            'POST',
            [

                'url' =>
                    $imagen_url,

                'caption' =>
                    $texto,

                'published' =>
                    'true',

                'access_token' =>
                    META_ACCESS_TOKEN

            ]
        );


    if (
        !$respuesta['ok']
    ) {

        return [

            'ok' => false,

            'estado' => 'ERROR',

            'error' =>
                $respuesta['error']
                ?: 'No fue posible publicar en Facebook.'

        ];

    }


    return [

        'ok' => true,

        'estado' => 'PUBLICADO',

        'publicacion_id' =>
            $respuesta['data']['id']
            ?? null,

        'data' =>
            $respuesta['data']

    ];
}


/*
|--------------------------------------------------------------------------
| CREAR CONTENEDOR INSTAGRAM
|--------------------------------------------------------------------------
*/

function meta_crear_contenedor_instagram(
    $imagen_url,
    $texto
) {

    if (
        !META_PUBLICAR_INSTAGRAM
    ) {

        return [

            'ok' => false,

            'estado' => 'NO_CONFIGURADO',

            'error' =>
                'La publicación en Instagram está desactivada.'

        ];

    }


    if (
        META_INSTAGRAM_USER_ID === '' ||
        META_INSTAGRAM_USER_ID ===
            'PON_AQUI_EL_ID_DE_INSTAGRAM'
    ) {

        return [

            'ok' => false,

            'estado' => 'NO_CONFIGURADO',

            'error' =>
                'No se configuró el Instagram profesional.'

        ];

    }


    $respuesta =
        meta_request(
            META_INSTAGRAM_USER_ID . '/media',
            'POST',
            [

                'image_url' =>
                    $imagen_url,

                'caption' =>
                    $texto,

                'access_token' =>
                    META_ACCESS_TOKEN

            ]
        );


    if (
        !$respuesta['ok']
    ) {

        return [

            'ok' => false,

            'estado' => 'ERROR',

            'error' =>
                $respuesta['error']
                ?: 'No fue posible crear el contenido de Instagram.'

        ];

    }


    return [

        'ok' => true,

        'creation_id' =>
            $respuesta['data']['id']
            ?? null

    ];
}


/*
|--------------------------------------------------------------------------
| PUBLICAR INSTAGRAM
|--------------------------------------------------------------------------
*/

function meta_publicar_instagram(
    $imagen_url,
    $texto
) {

    $contenedor =
        meta_crear_contenedor_instagram(
            $imagen_url,
            $texto
        );


    if (
        !$contenedor['ok']
    ) {

        return $contenedor;

    }


    $creation_id =
        $contenedor['creation_id']
        ?? '';


    if (
        $creation_id === ''
    ) {

        return [

            'ok' => false,

            'estado' => 'ERROR',

            'error' =>
                'Instagram no devolvió el ID del contenedor.'

        ];

    }


    /*
    |--------------------------------------------------------------------------
    | PUBLICAR CONTENEDOR
    |--------------------------------------------------------------------------
    */

    $respuesta =
        meta_request(
            META_INSTAGRAM_USER_ID . '/media_publish',
            'POST',
            [

                'creation_id' =>
                    $creation_id,

                'access_token' =>
                    META_ACCESS_TOKEN

            ]
        );


    if (
        !$respuesta['ok']
    ) {

        return [

            'ok' => false,

            'estado' => 'ERROR',

            'error' =>
                $respuesta['error']
                ?: 'No fue posible publicar en Instagram.'

        ];

    }


    return [

        'ok' => true,

        'estado' => 'PUBLICADO',

        'publicacion_id' =>
            $respuesta['data']['id']
            ?? null,

        'data' =>
            $respuesta['data']

    ];
}
```

