# 4. Crear `publicar_material.php`

Este será el archivo que realmente ejecutará la publicación.

Crea:

```text
C:\xampp\htdocs\inventario\marketing\publicar_material.php
```

```php
<?php

require_once __DIR__ . '/conexion.php';
require_once __DIR__ . '/meta_api.php';


/*
|--------------------------------------------------------------------------
| PUBLICAR MATERIAL
|--------------------------------------------------------------------------
*/

function publicar_material(
    mysqli $conexion,
    int $material_id
) {

    /*
    |--------------------------------------------------------------------------
    | BUSCAR MATERIAL
    |--------------------------------------------------------------------------
    */

    $sql = "
        SELECT

            m.id,
            m.nombre,
            m.descripcion,
            m.ruta_archivo,
            m.extension,
            m.estado,

            c.nombre AS categoria,

            ca.nombre AS campana

        FROM marketing_materiales m

        LEFT JOIN marketing_categorias c
            ON c.id = m.categoria_id

        LEFT JOIN marketing_campanas ca
            ON ca.id = m.campana_id

        WHERE m.id = ?

        LIMIT 1
    ";


    $stmt =
        $conexion->prepare($sql);


    if (!$stmt) {

        return [

            'ok' => false,

            'error' =>
                'No fue posible consultar el material.'

        ];

    }


    $stmt->bind_param(
        'i',
        $material_id
    );


    $stmt->execute();


    $resultado =
        $stmt->get_result();


    if (
        !$resultado ||
        $resultado->num_rows !== 1
    ) {

        $stmt->close();


        return [

            'ok' => false,

            'error' =>
                'El material no existe.'

        ];

    }


    $material =
        $resultado->fetch_assoc();


    $stmt->close();


    /*
    |--------------------------------------------------------------------------
    | VALIDAR ESTADO
    |--------------------------------------------------------------------------
    */

    if (
        ($material['estado'] ?? '') !==
        'AUTORIZADO'
    ) {

        return [

            'ok' => false,

            'error' =>
                'El material todavía no está autorizado.'

        ];

    }


    /*
    |--------------------------------------------------------------------------
    | VALIDAR IMAGEN
    |--------------------------------------------------------------------------
    */

    $ext =
        strtolower(
            trim(
                $material['extension'] ?? ''
            )
        );


    $extensionesPermitidas = [

        'jpg',
        'jpeg',
        'png',
        'webp'

    ];


    if (
        !in_array(
            $ext,
            $extensionesPermitidas,
            true
        )
    ) {

        return [

            'ok' => false,

            'error' =>
                'Este material no es una imagen compatible con la publicación automática.'

        ];

    }


    /*
    |--------------------------------------------------------------------------
    | CONSTRUIR URL PÚBLICA
    |--------------------------------------------------------------------------
    */

    $nombreArchivo =
        basename(
            $material['ruta_archivo']
        );


    $imagen_url =
        rtrim(
            MARKETING_PUBLIC_URL,
            '/'
        )
        . '/'
        . rawurlencode(
            $nombreArchivo
        );


    /*
    |--------------------------------------------------------------------------
    | CREAR TEXTO
    |--------------------------------------------------------------------------
    */

    $texto = '';


    if (
        !empty(
            $material['nombre']
        )
    ) {

        $texto .=
            $material['nombre'] . "\n\n";

    }


    if (
        !empty(
            $material['descripcion']
        )
    ) {

        $texto .=
            $material['descripcion'] . "\n\n";

    }


    if (
        !empty(
            $material['campana']
        )
    ) {

        $texto .=
            '#'
            . preg_replace(
                '/[^a-zA-Z0-9áéíóúÁÉÍÓÚñÑ]/u',
                '',
                $material['campana']
            )
            . "\n";

    }


    $texto .=
        "#GrupoProtec";


    /*
    |--------------------------------------------------------------------------
    | INSERTAR REGISTRO DE PUBLICACIÓN
    |--------------------------------------------------------------------------
    */

    $sqlExiste = "
        SELECT id
        FROM marketing_publicaciones
        WHERE material_id = ?
        LIMIT 1
    ";


    $stmtExiste =
        $conexion->prepare(
            $sqlExiste
        );


    $stmtExiste->bind_param(
        'i',
        $material_id
    );


    $stmtExiste->execute();


    $resultadoExiste =
        $stmtExiste->get_result();


    if (
        $resultadoExiste &&
        $resultadoExiste->num_rows > 0
    ) {

        $fila =
            $resultadoExiste->fetch_assoc();

        $publicacion_id =
            (int)$fila['id'];

        $stmtExiste->close();

    } else {

        $stmtExiste->close();


        $sqlInsert = "
            INSERT INTO marketing_publicaciones
            (
                material_id,
                texto_publicacion
            )
            VALUES
            (
                ?,
                ?
            )
        ";


        $stmtInsert =
            $conexion->prepare(
                $sqlInsert
            );


        $stmtInsert->bind_param(
            'is',
            $material_id,
            $texto
        );


        if (
            !$stmtInsert->execute()
        ) {

            $stmtInsert->close();


            return [

                'ok' => false,

                'error' =>
                    'No fue posible crear el registro de publicación.'

            ];

        }


        $publicacion_id =
            $stmtInsert->insert_id;


        $stmtInsert->close();

    }


    /*
    |--------------------------------------------------------------------------
    | FACEBOOK
    |--------------------------------------------------------------------------
    */

    $facebook =
        meta_publicar_facebook(
            $imagen_url,
            $texto
        );


    if (
        $facebook['ok']
    ) {

        $facebook_estado =
            'PUBLICADO';

        $facebook_id =
            $facebook['publicacion_id']
            ?? null;

        $facebook_error = null;

    } else {

        $facebook_estado =
            $facebook['estado']
            ?? 'ERROR';

        $facebook_id = null;

        $facebook_error =
            $facebook['error']
            ?? 'Error desconocido.';

    }


    /*
    |--------------------------------------------------------------------------
    | GUARDAR FACEBOOK
    |--------------------------------------------------------------------------
    */

    $sqlFacebook = "
        UPDATE marketing_publicaciones
        SET

            facebook_estado = ?,

            facebook_publicacion_id = ?,

            facebook_fecha =
                CASE
                    WHEN ? = 'PUBLICADO'
                    THEN NOW()
                    ELSE facebook_fecha
                END,

            facebook_error = ?,

            intentos_facebook =
                intentos_facebook + 1

        WHERE id = ?
    ";


    $stmtFacebook =
        $conexion->prepare(
            $sqlFacebook
        );


    $stmtFacebook->bind_param(
        'ssssi',
        $facebook_estado,
        $facebook_id,
        $facebook_estado,
        $facebook_error,
        $publicacion_id
    );


    $stmtFacebook->execute();


    $stmtFacebook->close();


    /*
    |--------------------------------------------------------------------------
    | INSTAGRAM
    |--------------------------------------------------------------------------
    */

    $instagram =
        meta_publicar_instagram(
            $imagen_url,
            $texto
        );


    if (
        $instagram['ok']
    ) {

        $instagram_estado =
            'PUBLICADO';

        $instagram_id =
            $instagram['publicacion_id']
            ?? null;

        $instagram_error = null;

    } else {

        $instagram_estado =
            $instagram['estado']
            ?? 'ERROR';

        $instagram_id = null;

        $instagram_error =
            $instagram['error']
            ?? 'Error desconocido.';

    }


    /*
    |--------------------------------------------------------------------------
    | GUARDAR INSTAGRAM
    |--------------------------------------------------------------------------
    */

    $sqlInstagram = "
        UPDATE marketing_publicaciones
        SET

            instagram_estado = ?,

            instagram_publicacion_id = ?,

            instagram_fecha =
                CASE
                    WHEN ? = 'PUBLICADO'
                    THEN NOW()
                    ELSE instagram_fecha
                END,

            instagram_error = ?,

            intentos_instagram =
                intentos_instagram + 1,

            ultima_publicacion = NOW()

        WHERE id = ?
    ";


    $stmtInstagram =
        $conexion->prepare(
            $sqlInstagram
        );


    $stmtInstagram->bind_param(
        'ssssi',
        $instagram_estado,
        $instagram_id,
        $instagram_estado,
        $instagram_error,
        $publicacion_id
    );


    $stmtInstagram->execute();


    $stmtInstagram->close();


    /*
    |--------------------------------------------------------------------------
    | RESULTADO
    |--------------------------------------------------------------------------
    */

    return [

        'ok' =>
            $facebook['ok'] ||
            $instagram['ok'],

        'publicacion_id' =>
            $publicacion_id,

        'facebook' =>
            $facebook,

        'instagram' =>
            $instagram

    ];
}
```

